---
const { id, example, table, version, csv, rules } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const assets = `${base}/tufte-examples`;
const variants = ['before', 'after'];
type Cell = string | number | null;
const grouped = table?.columns[0] === 'Topic';
const valueGroups = new Map<Cell, Cell[][]>();
for (const row of (table?.rows ?? []) as Cell[][]) {
  const topic = grouped ? row[0] : null;
  if (!valueGroups.has(topic)) valueGroups.set(topic, []);
  valueGroups.get(topic)!.push(grouped ? row.slice(1) : row);
}
---
<p>{example.question}</p>
<p>{example.source}</p>
<blockquote>
  <p>“{example.book.quote}”</p>
  <footer>Edward Tufte, <cite>The Visual Display of Quantitative Information</cite>, second edition, p. {example.book.page}.</footer>
</blockquote>

{variants.map((variant) => (
  <section>
    <h2 id={variant}>{variant === 'before' ? 'Before' : 'After'}</h2>
    <figure aria-labelledby={variant} aria-describedby={`${variant}-caption example-values`}>
      <div class="chart" data-plotly-spec={`${assets}/${id}/${variant}.json`}
        data-plotly-bundle={`${assets}/plotly-${version}.min.js`}
        data-plotly-variant={variant} aria-hidden="true"></div>
      <label data-plotly-frames hidden>Frame <select></select></label>
      <p data-plotly-error hidden>Interactive chart unavailable.</p>
      <figcaption id={`${variant}-caption`}>{example[variant].caption}</figcaption>
    </figure>
    <p><a href={`${assets}/${id}/${variant}.py`} download>Download {variant} Python code</a></p>
  </section>
))}

<h2 id="values">Values</h2>
<div id="example-values">
  <p>{example.before.summary}</p>
  {example.after.summary !== example.before.summary && <p>{example.after.summary}</p>}
</div>
{table && (
  <table>
    <caption>Values used in both charts</caption>
    <thead><tr>{table.columns.slice(grouped ? 1 : 0).map((column: string) => <th scope="col">{column}</th>)}</tr></thead>
    {[...valueGroups].map(([topic, rows]) => (
      <tbody>
        {topic !== null && <tr><th scope="rowgroup" colspan={table.columns.length - 1}>{topic}</th></tr>}
        {rows.map(([label, ...cells]) => (
          <tr><th scope="row">{label ?? 'Missing'}</th>{cells.map((cell) => <td>{cell ?? 'Missing'}</td>)}</tr>
        ))}
      </tbody>
    ))}
  </table>
)}
{csv && <p><a href={`${assets}/${id}/values.csv`} download>Download all values as CSV</a></p>}

{rules.length > 0 && (
  <>
    <h2 id="rules">Related rules</h2>
    <ul>{rules.map((rule: string) => <li><a href={`${base}/rules/${rule}/`}>{rule}</a></li>)}</ul>
  </>
)}

<style>
  figure {
    margin-inline: 0;
  }

  .chart {
    width: 100%;
    border-radius: 6px;
    overflow: hidden;
  }

  .chart:empty {
    display: none;
  }

  .chart[data-plotly-loading] {
    display: block;
  }

  figcaption {
    margin-block-start: 0.5rem;
  }
</style>

<script>
  type Trace = Record<string, any>;
  type FigureSpec = {
    data: Trace[];
    layout: Record<string, any>;
    frames?: { name: string }[];
  };

  type Plotly = {
    newPlot: (chart: HTMLElement, spec: FigureSpec & { config: object }) => Promise<unknown>;
    react: (chart: HTMLElement, data: Trace[], layout: Record<string, any>, config: object) => Promise<unknown>;
    relayout: (chart: HTMLElement, layout: object) => Promise<unknown>;
    animate: (chart: HTMLElement, frames: string[], options: object) => Promise<unknown>;
  };

  let bundle: Promise<Plotly> | undefined;

  function loadPlotly(src: string) {
    bundle ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve((window as Window & { Plotly: Plotly }).Plotly);
      script.onerror = reject;
      document.head.append(script);
    });
    return bundle;
  }

  const isDarkTheme = () => document.documentElement.dataset.theme === 'dark';

  const DARK_INKS = new Set([
    'black', '#000', '#000000', '#111', '#111111', '#1f2937', '#222', '#222222',
    '#242424', '#333', '#333333', '#353535', 'rgb(36,36,36)', 'rgb(0,0,0)',
  ]);

  function normalizeInk(color: unknown, dark: boolean, fg: string) {
    if (!dark || typeof color !== 'string') return color;
    return DARK_INKS.has(color.trim().toLowerCase().replaceAll(' ', '')) ? fg : color;
  }

  function hasExplicitTintedBg(spec: FigureSpec, variant: string) {
    if (variant !== 'before') return false;
    const layout = spec.layout ?? {};
    const tmplBg = layout.template?.layout?.plot_bgcolor;
    const explicitBg = layout.plot_bgcolor ?? layout.paper_bgcolor;
    const isTinted = (bg: unknown) =>
      typeof bg === 'string' && !['white', '#fff', '#ffffff', 'rgba(0,0,0,0)', 'transparent'].includes(bg.trim().toLowerCase());
    return isTinted(explicitBg) || isTinted(tmplBg);
  }

  function applyTheme(spec: FigureSpec, variant: string, dimensions: { width: number; height: number }) {
    const dark = isDarkTheme();
    const layout = structuredClone(spec.layout ?? {});
    const data = structuredClone(spec.data ?? []);
    const frames = spec.frames ?? [];
    const frameControls = frames.length ? { updatemenus: [], sliders: [] } : {};

    if (hasExplicitTintedBg(spec, variant)) {
      return { data, layout: { ...layout, ...frameControls, ...dimensions } };
    }

    const fg = dark ? '#e6e8ec' : '#1f2937';
    const muted = dark ? '#9ca3af' : '#4b5563';
    const axisLine = dark ? '#6b7280' : '#4b5563';
    const grid = dark ? 'rgba(255,255,255,0.12)' : 'rgba(15,23,42,0.08)';
    const hoverBg = dark ? '#1f232b' : '#ffffff';
    const hoverBorder = dark ? '#374151' : '#d1d5db';
    const tableHeaderBg = dark ? 'rgba(255,255,255,0.06)' : 'rgba(15,23,42,0.04)';
    const tableRule = dark ? 'rgba(255,255,255,0.18)' : 'rgba(15,23,42,0.14)';

    layout.paper_bgcolor = 'rgba(0,0,0,0)';
    layout.plot_bgcolor = 'rgba(0,0,0,0)';
    layout.font = { ...layout.font, color: fg };
    if (layout.title && typeof layout.title === 'object') {
      layout.title.font = { ...layout.title.font, color: fg };
      if (layout.title.subtitle && typeof layout.title.subtitle === 'object') {
        layout.title.subtitle.font = { ...layout.title.subtitle.font, color: muted };
      }
    }
    layout.hoverlabel = {
      ...layout.hoverlabel,
      bgcolor: hoverBg,
      bordercolor: hoverBorder,
      font: { ...layout.hoverlabel?.font, color: fg },
    };
    if (layout.legend && typeof layout.legend === 'object') {
      layout.legend.bgcolor = 'rgba(0,0,0,0)';
      layout.legend.font = { ...layout.legend.font, color: fg };
    }

    const axisKeys = new Set<string>(Object.keys(layout).filter((k) => /^(?:x|y)axis\d*$/.test(k)));
    const hasCartesian = data.some((t) => !['table', 'pie', 'indicator', 'sunburst', 'scatter3d'].includes(t.type ?? 'scatter'));
    if (hasCartesian) {
      axisKeys.add('xaxis');
      axisKeys.add('yaxis');
    }
    for (const key of axisKeys) {
      const axis = { ...(layout[key] ?? {}) };
      axis.automargin = axis.automargin ?? true;
      axis.linecolor = normalizeInk(axis.linecolor ?? axisLine, dark, axisLine);
      axis.tickcolor = normalizeInk(axis.tickcolor ?? axisLine, dark, axisLine);
      axis.tickfont = { ...axis.tickfont, color: muted };
      if (axis.title && typeof axis.title === 'object') {
        axis.title = { ...axis.title, font: { ...axis.title.font, color: muted } };
      } else if (typeof axis.title === 'string') {
        axis.title = { text: axis.title, font: { color: muted } };
      }
      if (axis.showgrid && !axis.gridcolor) axis.gridcolor = grid;
      if (axis.zerolinecolor) axis.zerolinecolor = normalizeInk(axis.zerolinecolor, dark, grid);
      layout[key] = axis;
    }

    if (Array.isArray(layout.annotations)) {
      layout.annotations = layout.annotations.map((ann: Record<string, any>) => ({
        ...ann,
        font: { ...ann.font, color: normalizeInk(ann.font?.color ?? fg, dark, fg) },
      }));
    }
    if (Array.isArray(layout.shapes)) {
      layout.shapes = layout.shapes.map((shape: Record<string, any>) => {
        if (!shape.line?.color) return shape;
        return { ...shape, line: { ...shape.line, color: normalizeInk(shape.line.color, dark, axisLine) } };
      });
    }

    for (const trace of data) {
      if (trace.type === 'table') {
        const keepBeforeTable = variant === 'before' && (Array.isArray(trace.cells?.fill?.color) || (trace.cells?.line?.width ?? 0) >= 2);
        if (keepBeforeTable) {
          trace.header = { ...trace.header, font: { ...trace.header?.font, color: '#1f2937' } };
          trace.cells = { ...trace.cells, font: { ...trace.cells?.font, color: '#1f2937' } };
        } else {
          trace.header = {
            ...trace.header,
            fill: { color: tableHeaderBg },
            line: { color: tableRule, width: trace.header?.line?.width ?? 1 },
            font: { ...trace.header?.font, color: fg },
          };
          trace.cells = {
            ...trace.cells,
            fill: { color: 'rgba(0,0,0,0)' },
            line: { color: tableRule, width: trace.cells?.line?.width ?? 0 },
            font: { ...trace.cells?.font, color: fg },
          };
        }
      } else {
        if (trace.line?.color) trace.line.color = normalizeInk(trace.line.color, dark, fg);
        if (trace.marker?.color) trace.marker.color = normalizeInk(trace.marker.color, dark, fg);
        if (trace.textfont?.color) trace.textfont.color = normalizeInk(trace.textfont.color, dark, fg);
      }
    }

    return { data, layout: { ...layout, ...frameControls, ...dimensions } };
  }

  async function draw(chart: HTMLElement) {
    try {
      const [plotly, response] = await Promise.all([
        loadPlotly(chart.dataset.plotlyBundle!),
        fetch(chart.dataset.plotlySpec!),
      ]);
      if (!response.ok) throw new Error(`Plotly figure request failed: ${response.status}`);
      const spec: FigureSpec = await response.json();
      const variant = chart.dataset.plotlyVariant ?? 'after';
      const { width = 700, height = 450 } = spec.layout ?? {};
      chart.dataset.plotlyLoading = '';
      const hasTable = spec.data.some(({ type }) => type === 'table');
      const size = () => {
        const available = Math.min(width, chart.clientWidth);
        const chartHeight = Math.max(Math.min(height, 320), Math.round(available * height / width));
        return { width: available, height: hasTable ? height : chartHeight };
      };
      let lastWidth = size().width;
      const frames = spec.frames ?? [];
      const config = { displayModeBar: false, responsive: true };
      const initial = applyTheme(spec, variant, size());
      await plotly.newPlot(chart, {
        ...spec,
        data: initial.data,
        layout: initial.layout,
        config,
      });
      if (frames.length) {
        const label = chart.parentElement!.querySelector<HTMLLabelElement>('[data-plotly-frames]')!;
        const select = label.querySelector('select')!;
        select.replaceChildren(...frames.map(({ name }) => new Option(name, name)));
        select.addEventListener('change', () => {
          void plotly.animate(chart, [select.value], {
            mode: 'immediate',
            frame: { duration: 0 },
            transition: { duration: 0 },
          }).catch(console.error);
        });
        label.hidden = false;
      }
      chart.dataset.plotlyReady = '';
      new ResizeObserver(() => {
        const dimensions = size();
        if (dimensions.width === lastWidth) return;
        lastWidth = dimensions.width;
        void plotly.relayout(chart, dimensions);
      }).observe(chart);
      new MutationObserver(() => {
        const updated = applyTheme(spec, variant, size());
        void plotly.react(chart, updated.data, updated.layout, config);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    } catch (error) {
      console.error(error);
      chart.replaceChildren();
      chart.parentElement?.querySelector<HTMLElement>('[data-plotly-error]')?.removeAttribute('hidden');
    } finally {
      delete chart.dataset.plotlyLoading;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-plotly-spec]').forEach((chart) => void draw(chart));
</script>
