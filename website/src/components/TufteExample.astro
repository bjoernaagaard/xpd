---
const { id, example, table, version, csv, rules } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const assets = `${base}/tufte-examples`;
const variants = ['before', 'after'];
type Cell = string | number | null;
const grouped = table?.columns[0] === 'Topic';
const valueGroups = new Map<Cell, Cell[][]>();
for (const row of (table?.rows ?? []) as Cell[][]) {
  const topic = grouped ? row[0] : null;
  if (!valueGroups.has(topic)) valueGroups.set(topic, []);
  valueGroups.get(topic)!.push(grouped ? row.slice(1) : row);
}
---
<p>{example.question}</p>
<p>{example.source}</p>
<blockquote>
  <p>“{example.book.quote}”</p>
  <footer>Edward Tufte, <cite>The Visual Display of Quantitative Information</cite>, second edition, p. {example.book.page}.</footer>
</blockquote>

{variants.map((variant) => (
  <section>
    <h2 id={variant}>{variant === 'before' ? 'Before' : 'After'}</h2>
    <figure aria-labelledby={variant} aria-describedby={`${variant}-caption example-values`}>
      <div class="chart" data-plotly-spec={`${assets}/${id}/${variant}.json`}
        data-plotly-bundle={`${assets}/plotly-${version}.min.js`} aria-hidden="true"></div>
      <label data-plotly-frames hidden>Frame <select></select></label>
      <p data-plotly-error hidden>Interactive chart unavailable.</p>
      <figcaption id={`${variant}-caption`}>{example[variant].caption}</figcaption>
    </figure>
    <p><a href={`${assets}/${id}/${variant}.py`} download>Download {variant} Python code</a></p>
  </section>
))}

<h2 id="values">Values</h2>
<div id="example-values">
  <p>{example.before.summary}</p>
  {example.after.summary !== example.before.summary && <p>{example.after.summary}</p>}
</div>
{table && (
  <table>
    <caption>Values used in both charts</caption>
    <thead><tr>{table.columns.slice(grouped ? 1 : 0).map((column: string) => <th scope="col">{column}</th>)}</tr></thead>
    {[...valueGroups].map(([topic, rows]) => (
      <tbody>
        {topic !== null && <tr><th scope="rowgroup" colspan={table.columns.length - 1}>{topic}</th></tr>}
        {rows.map(([label, ...cells]) => (
          <tr><th scope="row">{label ?? 'Missing'}</th>{cells.map((cell) => <td>{cell ?? 'Missing'}</td>)}</tr>
        ))}
      </tbody>
    ))}
  </table>
)}
{csv && <p><a href={`${assets}/${id}/values.csv`} download>Download all values as CSV</a></p>}

{rules.length > 0 && (
  <>
    <h2 id="rules">Related rules</h2>
    <ul>{rules.map((rule: string) => <li><a href={`${base}/rules/${rule}/`}>{rule}</a></li>)}</ul>
  </>
)}

<style>
  figure {
    margin-inline: 0;
  }

  .chart {
    width: 100%;
    color-scheme: light;
  }

  .chart:empty {
    display: none;
  }

  .chart[data-plotly-loading] {
    display: block;
  }

  figcaption {
    margin-block-start: 0.5rem;
  }
</style>

<script>
  type FigureSpec = {
    data: { type?: string }[];
    layout: { width?: number; height?: number };
    frames?: { name: string }[];
  };

  type Plotly = {
    newPlot: (chart: HTMLElement, spec: FigureSpec & { config: object }) => Promise<unknown>;
    relayout: (chart: HTMLElement, layout: object) => Promise<unknown>;
    animate: (chart: HTMLElement, frames: string[], options: object) => Promise<unknown>;
  };

  let bundle: Promise<Plotly> | undefined;

  function loadPlotly(src: string) {
    bundle ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve((window as Window & { Plotly: Plotly }).Plotly);
      script.onerror = reject;
      document.head.append(script);
    });
    return bundle;
  }

  async function draw(chart: HTMLElement) {
    try {
      const [plotly, response] = await Promise.all([
        loadPlotly(chart.dataset.plotlyBundle!),
        fetch(chart.dataset.plotlySpec!),
      ]);
      if (!response.ok) throw new Error(`Plotly figure request failed: ${response.status}`);
      const spec: FigureSpec = await response.json();
      const { width = 700, height = 450 } = spec.layout ?? {};
      chart.dataset.plotlyLoading = '';
      const hasTable = spec.data.some(({ type }) => type === 'table');
      const size = () => {
        const available = Math.min(width, chart.clientWidth);
        const chartHeight = Math.max(Math.min(height, 320), Math.round(available * height / width));
        return { width: available, height: hasTable ? height : chartHeight };
      };
      let lastWidth = size().width;
      const frames = spec.frames ?? [];
      const frameControls = frames.length ? { updatemenus: [], sliders: [] } : {};
      await plotly.newPlot(chart, {
        ...spec,
        layout: { ...spec.layout, ...frameControls, ...size() },
        config: { displayModeBar: false, responsive: true },
      });
      if (frames.length) {
        const label = chart.parentElement!.querySelector<HTMLLabelElement>('[data-plotly-frames]')!;
        const select = label.querySelector('select')!;
        select.replaceChildren(...frames.map(({ name }) => new Option(name, name)));
        select.addEventListener('change', () => {
          void plotly.animate(chart, [select.value], {
            mode: 'immediate',
            frame: { duration: 0 },
            transition: { duration: 0 },
          }).catch(console.error);
        });
        label.hidden = false;
      }
      chart.dataset.plotlyReady = '';
      new ResizeObserver(() => {
        const dimensions = size();
        if (dimensions.width === lastWidth) return;
        lastWidth = dimensions.width;
        void plotly.relayout(chart, dimensions);
      }).observe(chart);
    } catch (error) {
      console.error(error);
      chart.replaceChildren();
      chart.parentElement?.querySelector<HTMLElement>('[data-plotly-error]')?.removeAttribute('hidden');
    } finally {
      delete chart.dataset.plotlyLoading;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-plotly-spec]').forEach((chart) => void draw(chart));
</script>
