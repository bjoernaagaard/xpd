default_install_hook_types: [pre-commit, pre-push]
repos:
  - repo: https://github.com/astral-sh/uv-pre-commit
    rev: 0.13.9
    hooks:
      - id: uv-lock
        args: [--check]
        stages: [pre-commit]
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff-check
        language: unsupported
        entry: uv run --locked ruff check
        types_or: [python, pyi, jupyter]
        stages: [pre-commit]
      - id: ruff-format
        name: ruff-format
        language: unsupported
        entry: uv run --locked ruff format --check
        types_or: [python, pyi, jupyter]
        stages: [pre-commit]
      - id: tombi-lint
        name: tombi-lint
        language: unsupported
        entry: uvx tombi@1.11.3 lint
        files: '\.toml$'
        stages: [pre-commit]
      - id: tombi-format
        name: tombi-format
        language: unsupported
        entry: uvx tombi@1.11.3 format --check
        files: '\.toml$'
        stages: [pre-commit]
      - id: yamllint
        name: yamllint
        language: unsupported
        entry: uvx yamllint@1.38.0 --strict
        types_or: [yaml]
        stages: [pre-commit]
        args: [-d, '{rules: {key-duplicates: enable, new-line-at-end-of-file: enable, trailing-spaces: enable}}']
      - id: ty
        name: ty
        language: unsupported
        entry: uv run --locked ty check
        pass_filenames: false
        types: [python]
        stages: [pre-push]
      - id: pytest
        name: pytest
        language: unsupported
        entry: uv run --locked pytest
        pass_filenames: false
        types: [python]
        stages: [pre-push]
        files: '(^|/)(tests?/|test_[^/]*\.py$|[^/]*_test\.py$)'
