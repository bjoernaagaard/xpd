pre-commit:
  parallel: true
  commands:
    ruff-check:
      glob: "*.{py,pyi,ipynb}"
      run: uvx --exclude-newer=P3D ruff@0.17.4 check {staged_files}
    ruff-format:
      glob: "*.{py,pyi,ipynb}"
      run: uvx --exclude-newer=P3D ruff@0.17.4 format --check {staged_files}
    tombi-lint:
      glob: "*.toml"
      run: uvx --exclude-newer=P3D tombi@1.11.3 lint {staged_files}
    tombi-format:
      glob: "*.toml"
      run: uvx --exclude-newer=P3D tombi@1.11.3 format --check {staged_files}
    rumdl:
      glob: "*.md"
      run: uvx --exclude-newer=P3D rumdl@0.3.5 check {staged_files}
    yamllint:
      glob: "*.{yml,yaml}"
      run: uvx --exclude-newer=P3D yamllint@1.38.0 --strict {staged_files}
    jactionlint:
      glob: ".github/**/*.{yml,yaml}"
      run: uvx --exclude-newer=P3D jactionlint@2.6.0 --no-online --strict-exit {staged_files}
    typos:
      run: uvx --exclude-newer=P3D typos@1.52.2 {staged_files}
    shellcheck:
      file_types:
        - text/x-shellscript
        - text/x-sh
      run: uvx --exclude-newer=P3D --from shellcheck-py==0.11.0.1 shellcheck {staged_files}
    shfmt:
      file_types:
        - text/x-shellscript
        - text/x-sh
      run: uvx --exclude-newer=P3D --from shfmt-py==4.2.0 shfmt --diff {staged_files}
    nbstripout:
      glob: "*.ipynb"
      run: uvx --exclude-newer=P3D nbstripout@0.9.2 --verify {staged_files}
    gitleaks:
      skip:
        - run: "! command -v gitleaks"
      run: gitleaks git --staged --redact --no-banner
