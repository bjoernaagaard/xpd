default_install_hook_types: [pre-commit]
repos:
  - repo: local
    hooks:
      - id: ruff-check
        name: ruff-check
        language: unsupported
        entry: uvx ruff@0.17.4 check
        types_or: [python, pyi, jupyter]
        stages: [pre-commit]
      - id: ruff-format
        name: ruff-format
        language: unsupported
        entry: uvx ruff@0.17.4 format --check
        types_or: [python, pyi, jupyter]
        stages: [pre-commit]
      - id: tombi-lint
        name: tombi-lint
        language: unsupported
        entry: uvx tombi@1.11.3 lint
        files: '\.toml$'
        stages: [pre-commit]
      - id: tombi-format
        name: tombi-format
        language: unsupported
        entry: uvx tombi@1.11.3 format --check
        files: '\.toml$'
        stages: [pre-commit]
      - id: yamllint
        name: yamllint
        language: unsupported
        entry: uvx yamllint@1.38.0 --strict
        types_or: [yaml]
        stages: [pre-commit]
        args: [-d, '{rules: {key-duplicates: enable, new-line-at-end-of-file: enable, trailing-spaces: enable}}']
